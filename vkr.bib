@article{Simek,
  author = {Šimek, Bohuslav and Fiala, Dalibor and Dostal, Martin},
  title = {Register-Based and Stack-Based Virtual Machines: Which Perform Better in JIT Compilation Scenarios?},
  journal = {Software: Practice and Experience},
  volume = {55},
  number = {11},
  pages = {1896-1910},
  keywords = {just-in-time compilation, register-based VMs, stack-based VMs, virtual machines},
  doi = {https://doi.org/10.1002/spe.70014},
  url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/spe.70014},
  eprint = {https://onlinelibrary.wiley.com/doi/pdf/10.1002/spe.70014},
  abstract = {ABSTRACT Background Just-In-Time (JIT) compilation plays a critical role in optimizing the performance of modern virtual machines (VMs). While the architecture of VMs–register-based or stack-based–has long been a subject of debate, empirical analysis focusing on JIT compilation performance is relatively sparse. Objective In this study, we aim to answer the question: “Register-based and stack-based virtual machines: which perform better in JIT compilation scenarios?” Methods We explore this through a comprehensive set of benchmarks measuring execution speed. To achieve this, we developed identical test cases in languages that support both types of VM architectures and ran these tests under controlled conditions. The performance metrics were captured and analyzed for JIT compilation, including initial interpretation, bytecode translation, and optimized code execution. Results Our findings suggest that register-based VMs generally outperform stack-based VMs in terms of execution speed. Moreover, the performance gap between the two architectures in mixed execution mode, which essentially copies characteristics of the underlying virtual machine, suggests that making the right choice of VM architecture is still important. Conclusion This study provides developers, researchers, and system architects with actionable insights into the performance trade-offs associated with each VM architecture in JIT-compiled environments. The findings can guide the design decisions in the development of new virtual machines and JIT compilation strategies.},
  year = {2025}
}

@article{ThreadedCode,
  author = {Bell, James R.},
  title = {Threaded code},
  year = {1973},
  issue_date = {June 1973},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  volume = {16},
  number = {6},
  issn = {0001-0782},
  url = {https://doi.org/10.1145/362248.362270},
  doi = {10.1145/362248.362270},
  abstract = {The concept of “threaded code” is presented as an alternative to machine language code. Hardware and software realizations of it are given. In software it is realized as interpretive code not needing an interpreter. Extensions and optimizations are mentioned.},
  journal = {Commun. ACM},
  month = {June},
  pages = {370–372},
  numpages = {3},
  keywords = {time tradeoff, threaded code, subroutine calls, space tradeoff, machine code, interpreter, compiled code}
}
